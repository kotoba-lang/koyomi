{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc → portable to JVM / SCI / ClojureScript / GraalVM). Same runtime
 ;; kekkai/tayori ride on; a schedule-sharing control plane is just another
 ;; sealed-intelligence ⊣ independent-governor StateGraph.
 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.bytes replaced java.util.Base64 here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "e28a3bb010f240451dd8be22b087c920633ec28d"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/langgraph.git"
         :sha "5b4e5e70837b849b14b6a5800894e3be202ad5fa"}
        ;; canonical did:key + IPNS-name derivation (ADR-2607050100) — same
        ;; copy kekkai/tayori's CACAO issuance uses.
        io.github.kotoba-lang/ed25519
        {:sha "fdcefb9f1b83461fee54d04b63e374fa301ee847"}
        io.github.kotoba-lang/ipns
        {:sha "f2563eb1cb010c96f6dec1dfbd468fac93367498"}
        ;; the calendar.model event EDN koyomi holds verbatim as :draft
        ;; content — koyomi does NOT reimplement it (ADR-2607062010).
        io.github.kotoba-lang/calendar
        {:git/url "https://github.com/kotoba-lang/calendar.git"
                                     :git/sha "01163ded2616a604c24807f2c1e867b0db53510c"}
        ;; koyomi.distribute's REAL Resend ScheduleTarget builds its request
        ;; via kotoba-lang/mailer (which itself depends on kotoba-lang/mail
        ;; for mail.message/mail.draft/mail.receipt) rather than reimplementing
        ;; Resend request-building — same layering cloud-itonami.mail rides on.
        io.github.kotoba-lang/mailer
        {:git/url "https://github.com/kotoba-lang/mailer.git"
                                     :git/sha "64a5e4e6f7307c582f3d0d74eca4f6cadade9a5b"}
        ;; koyomi.distribute owns the network call + JSON envelope itself
        ;; (mirrors cloud_itonami.mail's charter: "only this namespace touches
        ;; the network ... mail.*/mailer.* stay pure") — same lightweight
        ;; org.clojure/data.json choice cloud-itonami's deps.edn lists first.
        io.github.kotoba-lang/json {:git/sha "b47b06486b3ad53051bc7d8bf361f4176f467202"}}
 :aliases
 {;; offline workspace dev — pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain {:local/root "../langchain"}}}
  ;; kbb -M:dev:run  → drive a schedule-share through one ScheduleActor
  :run {:main-opts ["-m" "koyomi.sim"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}